diff --git a/libkern/libkern/Block_private.h b/libkern/libkern/Block_private.h
--- a/libkern/libkern/Block_private.h
+++ b/libkern/libkern/Block_private.h
@@ -440,6 +440,15 @@ _Block_get_descriptor(struct Block_layout *aBlock)
 	uintptr_t disc = ptrauth_blend_discriminator(
 		&aBlock->descriptor, _Block_descriptor_ptrauth_discriminator);
 	return ptrauth_auth_data(aBlock->descriptor, ptrauth_key_asda, disc);
+#elif __has_feature(ptrauth_calls)
+	/*
+	 * OneiOS (board): the kexts of the collection are built by Apple's clang with signed block descriptor
+	 * pointers (key DA, the field's address blended with 0xC0BB); the stock clang this kernel is built with on Linux
+	 * has no ptrauth_signed_block_descriptors, so its own blocks carry a plain pointer. Take either: strip the
+	 * signature. (Block_copy of a kext's stack block read the signed pointer as an address: data abort, in the hosted
+	 * kernel on 2026-11-12 and in the standalone one under QEMU on 2026-11-19, IOService::addMatchingNotification.)
+	 */
+	return ptrauth_strip(aBlock->descriptor, ptrauth_key_asda);
 #else
 	return aBlock->descriptor;
 #endif
