+#if XNU_HOSTED || XNU_ONEIOS_NATIVE
+/*
+ * OneiOS native (0082: upstream's hosted 0083): AssistantServices' offline dictation status in mobile's preferences, for a Data store made from
+ * a seed that does not carry it (the image's roottweak writes the same key into new seeds: prefs.toml group
+ * "dictation"). -[AFDictationConnection forcedOfflineDictationIsAvailableForLanguage:synchronous:] caches the
+ * installed offline languages it reads from CFPreferences "Offline Dictation Status" (domain
+ * com.apple.assistant.support), and each time it fills that cache it posts _availabilityChanged to the main queue.
+ * Only an NSDictionary counts: with no value the cache stays nil, so every check fills it again and posts again. UIKit
+ * turns each post into UIKeyboardDictationAvailabilityDidChangeNotification; the keyboard's dock
+ * (UISystemKeyboardDockController updateDockItemsVisibility), UIKeyboardLayoutStar, the input assistant and the search
+ * bar redraw, and the dock's +[UIDictationController dictationIsFunctional] (unlocked: no "dictation enabled" check)
+ * asks -[AFDictationConnection dictationIsAvailableForLanguage:] again, which with no network checks the offline
+ * status again: a loop on the main thread of every app that shows a keyboard (read in AssistantServices and UIKitCore
+ * of 24A446). assistantd, which writes the status on an iPhone, is disabled by the daemon policy (group base). On the
+ * phone, 2026-11-22: Spotlight at 103-107% of a core with ~172000 failed faccessat of the dock's `mic.fill` per 30 s
+ * (the dock's glyph looked up again each turn), its main thread 13.8 s busy at launch so InputUI's arbiter dropped its
+ * keyboard (`timed out with 1 assertions remaining, disconnecting`), and Settings' main thread busy for more than 389 s
+ * while typing the Wi-Fi password. An empty dictionary (no offline language installed) makes the cache an empty set:
+ * filled once, posted once. Before launchd, /private/var/mobile/Library/Preferences/com.apple.assistant.support.plist
+ * is written when missing (XML, mobile 501:501 0600, as cfprefsd keeps a user's files); an XML file without the key
+ * gets it after its top <dict>; a file that names the key is kept; a binary file without it (cfprefsd's) is left
+ * alone and said so. oneios-dictation-status=0 turns it off. One line:
+ *   oneios-dictation: Offline Dictation Status: {} (written)      or: named there already: kept, ...
+ * 0083 also adds com.apple.navd to 0044's default oneios-enable-jobs list: with navd disabled (group base) the Maps widget
+ * (GeneralMapsWidget, MNNavigationServiceRemoteProxy) reconnects to com.apple.navigationService with no back-off, about
+ * 28000 times in the typing boot of 2026-11-22 (`failed to do a bootstrap look-up: xpc_error=No such process`), at
+ * 54-103% of a core with geod 30-46% and launchd 13-24% beside it.
+ */
+static void
+oneios_dictation_status(void)
+{
+	static const char path[] = "/private/var/mobile/Library/Preferences/com.apple.assistant.support.plist";
+	static const char dir[] = "/private/var/mobile/Library/Preferences";
+	static const char head[] = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\">\n<dict>\n";
+	static const char entry[] = "\t<key>Offline Dictation Status</key>\n\t<dict/>\n";
+	static const char tail[] = "</dict>\n</plist>\n";
+	static const char key[] = "Offline Dictation Status";
+	int enabled = 1;
+	(void)PE_parse_boot_argn("oneios-dictation-status", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("oneios-dictation: off (oneios-dictation-status=0)\n");
+		return;
+	}
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(dir, 0, &vp, ctx)) {
+		printf("oneios-dictation: no %s: nothing written\n", dir);
+		return;
+	}
+	vnode_put(vp);
+	vp = NULLVP;
+	const size_t cap = 64 * 1024;
+	char *text = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (text == NULL) {
+		printf("oneios-dictation: no memory: nothing written\n");
+		return;
+	}
+	const char *said = NULL;
+	size_t length = 0;
+	if (vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx) == 0) {
+		off_t size = -1;
+		int resid = 0;
+		(void)vnode_size(vp, &size, ctx);
+		int error = size <= 0 || (size_t)size + sizeof(entry) >= cap ? EFBIG : vn_rdwr(UIO_READ, vp, (caddr_t)text, (int)size,
+		    0, UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		vnode_close(vp, FREAD, ctx);
+		vp = NULLVP;
+		length = error || resid ? 0 : (size_t)size;
+		bool named = false;
+		/* the key's text is in a binary plist too (an ASCII string object), so this finds it in both */
+		for (size_t i = 0; length >= sizeof(key) - 1 && i + sizeof(key) - 1 <= length; i++) {
+			if (text[i] == key[0] && !memcmp(text + i, key, sizeof(key) - 1)) {
+				named = true;
+				break;
+			}
+		}
+		char *top = length ? strnstr(text, "<plist", length) : NULL;
+		top = top ? strnstr(top, "<dict>", length - (size_t)(top - text)) : NULL;
+		if (error || resid) {
+			said = "the file there is not readable: left alone";
+		} else if (named) {
+			said = "named there already: kept";
+		} else if (length >= 6 && !strncmp(text, "bplist", 6)) {
+			said = "the file there is cfprefsd's binary plist without it: left alone (the loop stays)";
+		} else if (top == NULL) {
+			said = "the file there has no top dictionary: left alone";
+		} else {
+			char *at = top + strlen("<dict>");
+			size_t add = sizeof(entry) - 1;
+			memmove(at + 1 + add, at, (size_t)(text + length - at));
+			at[0] = '\n';
+			memcpy(at + 1, entry, add);
+			length += 1 + add;
+		}
+	} else {
+		length = strlcpy(text, head, cap);
+		length = strlcat(text, entry, cap);
+		length = strlcat(text, tail, cap);
+	}
+	if (said == NULL) {
+		int error = native_gpu_addon_write(path, (const uint8_t *)text, length, 0600, ctx);
+		if (error <= 0 && vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx) == 0) {
+			struct vnode_attr va;
+			VATTR_INIT(&va);
+			VATTR_SET(&va, va_uid, 501);
+			VATTR_SET(&va, va_gid, 501);
+			error = vnode_setattr(vp, &va, ctx);
+			vnode_close(vp, FREAD, ctx);
+		}
+		said = error > 0 ? "not written" : "{} (written, mobile 0600)";
+	}
+	printf("oneios-dictation: Offline Dictation Status: %s (%s)\n", said, path);
+	kfree_data(text, cap);
+}
+#endif
 static void
 native_gpu_addon_prepare(proc_t p, user_addr_t scratch)
 {
@@ -9905,6 +10022,7 @@
 	oneios_swap_folder();                         /* 0057 */
 	oneios_log_persist();                         /* 0070 */
 	oneios_audio_tunings(p, scratch);             /* 0081 */
+	oneios_dictation_status();                    /* 0082 */
 #endif
 }
 
