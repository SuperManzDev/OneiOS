#!/system/bin/sh
# OneiOS native VM host preparation for one reviewed Galaxy S25 Ultra kernel.
# This command never stops Android, changes display state, reboots, or runs automatically.
set -u

MODDIR=/data/adb/modules/oneios_native_on_demand
CONF=$MODDIR/target.conf
BIN=$MODDIR/bin
LOCK=/data/local/tmp/oneios-native-on-demand.lock
OWNED=$MODDIR/state/owned
P=/sys/module/gh_hugepage_reserve/parameters
VM_DIR=/data/local/tmp/oneios-vmboot

PREPARE_NEW=0
say() { echo "oneios-native: $*"; }
die() {
    say "refused: $*" >&2
    [ "$PREPARE_NEW" = 1 ] && rollback_new_prepare
    exit 1
}
loaded() { grep -q "^$1 " /proc/modules 2>/dev/null; }
any_loaded() { loaded gh_hugepage_reserve || loaded gunyah_host_share || loaded udmabuf_gki_6.6 || loaded gunyah_halt_poll_gki_6.6; }
param() { cat "$P/$1" 2>/dev/null; }
sha() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }

full_root() {
    [ "$(id -u 2>/dev/null)" = 0 ] || die "run as root from an unrestricted KernelSU shell"
    head -n 1 /proc/kallsyms >/dev/null 2>&1 || die "root is restricted: /proc/kallsyms is not readable; grant the shell full KernelSU permission"
}

load_conf() {
    [ -r "$CONF" ] || die "missing $CONF"
    # Generated by build-module.sh from read-only phone facts; values are shell-quoted there.
    . "$CONF"
}

check_target() {
    load_conf
    model=$(getprop ro.product.model)
    device=$(getprop ro.product.device)
    kernel=$(uname -r)
    fingerprint=$(getprop ro.build.fingerprint)
    [ "$model" = "$TARGET_MODEL" ] || die "model $model, package is for $TARGET_MODEL"
    [ "$device" = "$TARGET_DEVICE" ] || die "device $device, package is for $TARGET_DEVICE"
    [ "$kernel" = "$TARGET_UNAME" ] || die "kernel $kernel, package is for $TARGET_UNAME; rebuild it before loading any module"
    [ "$fingerprint" = "$TARGET_FINGERPRINT" ] || die "build fingerprint changed; rebuild and repeat the ABI preflight before loading any module"
    [ "$(sha "$BIN/gh_hugepage_reserve.ko")" = "$SHA_HUGEPAGE" ] || die "huge-page module hash differs"
    [ "$(sha "$BIN/gunyah_host_share.ko")" = "$SHA_HOSTSHARE" ] || die "host-share module hash differs"
    [ "$(sha "$BIN/udmabuf_gki.ko")" = "$SHA_UDMABUF" ] || die "udmabuf module hash differs"
    [ "$(sha "$BIN/gunyah_halt_poll.ko")" = "$SHA_HALTPOLL" ] || die "halt-poll module hash differs"
}

status() {
    echo "target: $(getprop ro.product.model) $(getprop ro.product.device), kernel $(uname -r)"
    if loaded gh_hugepage_reserve; then
        echo "hugepool: loaded"
        cat "$P/refill_stat" 2>/dev/null || echo "  status unreadable (grant full KernelSU shell permission)"
        echo "pool_size_max=$(param pool_size_max) system_reserve_mb_default=$(param system_reserve_mb_default)"
    else
        echo "hugepool: not loaded"
    fi
    if loaded gunyah_host_share; then
        echo "hostshare: loaded; $(cat /sys/module/gunyah_host_share/parameters/outstanding 2>/dev/null)"
    else
        echo "hostshare: not loaded"
    fi
    if loaded udmabuf_gki_6.6; then
        echo "udmabuf: loaded; mode=$(cat /sys/module/udmabuf_gki_6.6/parameters/mode 2>/dev/null)"
    else
        echo "udmabuf: not loaded"
    fi
    if loaded gunyah_halt_poll_gki_6.6; then
        echo "halt-poll: loaded; halt_poll_ns=$(cat /sys/module/gunyah_halt_poll_gki_6.6/parameters/halt_poll_ns 2>/dev/null)"
    else
        echo "halt-poll: not loaded"
    fi
    if [ -f "$OWNED" ]; then
        state=$(sed -n 's/^state=//p' "$OWNED" | tail -n 1)
        echo "ownership: ${state:-unknown} (loaded by this command)"
    else
        echo "ownership: no command marker"
    fi
    if [ -f "$VM_DIR/kernel.img" ] && [ -f "$VM_DIR/boot.sh" ]; then
        echo "launcher: staged on phone"
    else
        echo "launcher: not staged; use oneios-tool phone vm-boot --stage-only"
    fi
    echo "automatic boot action: none"
}

write_param() {
    value=$1
    file=$2
    printf '%s\n' "$value" > "$file" 2>/dev/null || die "cannot write $file"
}

load_support() {
    loaded gunyah_host_share || insmod "$BIN/gunyah_host_share.ko" vmid_off="$VMID_OFF" rm_off="$RM_OFF" vm_status_off="$VM_STATUS_OFF" || die "host-share module did not load"
    [ -c /dev/gunyah_share ] || die "/dev/gunyah_share was not published"
    loaded udmabuf_gki_6.6 || insmod "$BIN/udmabuf_gki.ko" || die "udmabuf module did not load"
    loaded gunyah_halt_poll_gki_6.6 || insmod "$BIN/gunyah_halt_poll.ko" || die "halt-poll module did not load"
}

rollback_new_prepare() {
    PREPARE_NEW=0
    say "rolling back this failed prepare; Android and the display remain running"
    failed=0
    loaded gunyah_halt_poll_gki_6.6 && rmmod gunyah_halt_poll_gki_6.6 || true
    loaded gunyah_halt_poll_gki_6.6 && failed=1
    loaded udmabuf_gki_6.6 && rmmod udmabuf_gki_6.6 || true
    loaded udmabuf_gki_6.6 && failed=1
    loaded gunyah_host_share && rmmod gunyah_host_share || true
    loaded gunyah_host_share && failed=1
    loaded gh_hugepage_reserve && rmmod gh_hugepage_reserve || true
    loaded gh_hugepage_reserve && failed=1
    if [ "$failed" = 0 ]; then
        rm -f "$OWNED"
        say "rollback complete: no OneiOS support module remains loaded"
    else
        mkdir -p "$MODDIR/state"
        echo "state=partial" > "$OWNED"
        say "PARTIAL: rollback could not unload every module; use status, then release before a VM"
    fi
}

prepare() {
    ram=${1:-4096}
    case "$ram" in ''|*[!0-9]*) die "RAM_MIB must be an integer" ;; esac
    [ "$ram" -ge 512 ] && [ "$ram" -le 4096 ] || die "RAM_MIB must be 512..4096 for this first safety-gated module"
    need=$(( (ram - 32 + 1) / 2 ))
    say "explicit request: prepare a ${ram} MiB VM ($need pages of 2 MiB); Android and the screen stay running"
    check_target
    if any_loaded && [ ! -f "$OWNED" ]; then
        die "a support module was loaded outside this command; refusing to adopt or alter it. Unload it with its original tool or reboot"
    fi
    if any_loaded && ! grep -q '^state=ready$' "$OWNED" 2>/dev/null; then
        die "a previous prepare is partial; run release before trying again"
    fi
    if ! any_loaded && [ -f "$OWNED" ]; then
        die "the ownership marker is stale; run release to clear it before trying again"
    fi
    [ -c /dev/gunyah ] || die "no /dev/gunyah"
    if any_loaded; then PREPARE_NEW=0; else PREPARE_NEW=1; fi
    mkdir -p "$MODDIR/state" || die "cannot create module state"
    {
        echo "kernel=$TARGET_UNAME"
        echo "fingerprint=$TARGET_FINGERPRINT"
        echo "state=loading"
    } > "$OWNED" || die "cannot record module ownership"
    chmod 0600 "$OWNED"
    sync
    if ! loaded gh_hugepage_reserve; then
        insmod "$BIN/gh_hugepage_reserve.ko" pool_want="$need" pageblock_order_val="$PAGEBLOCK_ORDER" \
            migrate_cma_val="$MIGRATE_CMA" pool_want_with_cma=0 disable_kapi="$DISABLE_KAPI" || die "huge-page reserve module did not load"
    else
        write_param "$need" "$P/pool_want"
    fi
    load_support
    {
        echo "kernel=$TARGET_UNAME"
        echo "fingerprint=$TARGET_FINGERPRINT"
        echo "state=ready"
    } > "$OWNED"
    avail=$(param pool_avail)
    case "$avail" in ''|*[!0-9]*) die "pool availability is unreadable" ;; esac
    if [ "$avail" -lt "$need" ]; then
        say "pool has $avail/$need pages; one bounded mode-1 acquire will run without stopping One UI"
        write_param 1 "$P/acquire"
        n=0
        while [ "$n" -lt 60 ] && grep -q '^acquire_active=1$' "$P/refill_stat" 2>/dev/null; do sleep 1; n=$((n + 1)); done
        [ "$n" -lt 60 ] || write_param 0 "$P/acquire"
        avail=$(param pool_avail)
    fi
    status
    if [ "${avail:-0}" -lt "$need" ]; then
        if [ "$PREPARE_NEW" = 0 ]; then
            {
                echo "kernel=$TARGET_UNAME"
                echo "fingerprint=$TARGET_FINGERPRINT"
                echo "state=partial"
            } > "$OWNED"
        fi
        die "only ${avail:-0}/$need pages are available; no VM was started and the screen was not touched. Run release, reboot if desired, and invoke prepare earlier"
    fi
    PREPARE_NEW=0
    say "ready for a ${ram} MiB VM; nothing starts until the separate vm-boot command"
}

launch_vm() {
    check_target
    [ -f "$OWNED" ] && grep -q '^state=ready$' "$OWNED" || die "memory is not prepared; run prepare $LAUNCH_RAM_MIB first"
    for name in gh_hugepage_reserve gunyah_host_share udmabuf_gki_6.6 gunyah_halt_poll_gki_6.6; do
        loaded "$name" || die "$name is not loaded; refresh status and prepare again"
    done
    active=$(param active_vms)
    [ "${active:-0}" = 0 ] || die "$active VM(s) already active"
    avail=$(param pool_avail)
    case "$avail" in ''|*[!0-9]*) die "pool availability is unreadable" ;; esac
    [ "$avail" -ge "$LAUNCH_NEED_PAGES" ] || die "pool has $avail/$LAUNCH_NEED_PAGES pages for the staged ${LAUNCH_RAM_MIB} MiB VM"
    for file in kernel.img boot.sh ui.sh displayctl oneios-display liboneios-display.so oneios-display.dex bridgectl wifictl; do
        [ -e "$VM_DIR/$file" ] || die "staged launcher is incomplete: missing $VM_DIR/$file; stage it from the computer first"
    done
    ps -A -o ARGS= 2>/dev/null | grep -F "$VM_DIR/kernel.img" | grep -v grep >/dev/null && die "a OneiOS crosvm is already running"
    rm -f "$VM_DIR/result" "$VM_DIR/stop.request"
    say "launching the staged VM from the phone; One UI and this app will stop, so the screen may be black until iOS posts its first frame"
    if command -v setsid >/dev/null 2>&1; then
        setsid /system/bin/sh "$VM_DIR/boot.sh" </dev/null >/dev/null 2>&1 &
    else
        /system/bin/sh "$VM_DIR/boot.sh" </dev/null >/dev/null 2>&1 &
    fi
    launcher=$!
    sleep 2
    if ! kill -0 "$launcher" 2>/dev/null; then
        result=$(cat "$VM_DIR/result" 2>/dev/null)
        die "phone launcher ended before takeover${result:+: $result}"
    fi
    say "launch handed to the phone recovery script (pid $launcher); volume-down for 10 seconds or the 15-minute timer returns to One UI"
}

release_all() {
    check_target
    if any_loaded && [ ! -f "$OWNED" ]; then
        die "loaded modules have no ownership marker; refusing to unload modules another tool installed"
    fi
    if loaded gh_hugepage_reserve; then
        active=$(param active_vms)
        [ "${active:-0}" = 0 ] || die "$active VM(s) still own pool pages"
    fi
    if loaded gunyah_host_share; then
        outstanding=$(cat /sys/module/gunyah_host_share/parameters/outstanding 2>/dev/null)
        case "$outstanding" in *'total=0'*) ;; *) die "host-share still has outstanding parcels: ${outstanding:-unreadable}" ;; esac
    fi
    failed=0
    if loaded gunyah_halt_poll_gki_6.6; then rmmod gunyah_halt_poll_gki_6.6 || failed=1; fi
    if loaded udmabuf_gki_6.6; then rmmod udmabuf_gki_6.6 || failed=1; fi
    if loaded gunyah_host_share; then rmmod gunyah_host_share || failed=1; fi
    if loaded gh_hugepage_reserve; then rmmod gh_hugepage_reserve || failed=1; fi
    any_loaded && failed=1
    if [ "$failed" != 0 ]; then
        mkdir -p "$MODDIR/state"
        {
            echo "kernel=$TARGET_UNAME"
            echo "fingerprint=$TARGET_FINGERPRINT"
            echo "state=partial"
        } > "$OWNED"
        status
        die "one or more modules could not be unloaded; ownership is preserved as partial. Resolve the named module before another prepare"
    fi
    rm -f "$OWNED"
    say "released; verified that no OneiOS support module remains loaded; Android and the display were not restarted or stopped"
    status
}

usage() {
    cat <<'EOF'
usage: oneios-native status
       oneios-native prepare [RAM_MIB]
       oneios-native launch
       oneios-native release

Nothing runs at boot. `prepare` is the only command that reserves memory and keeps One UI running.
`launch` is a separate explicit action: it starts the staged phone-resident VM, stops One UI through the
reviewed takeover script, and may leave the panel black until iOS posts a frame. The takeover has a timer,
volume-down escape, and One UI recovery. `release` is refused while a VM or shared parcel is active.
EOF
}

cleanup_lock() { rmdir "$LOCK" 2>/dev/null || true; }
interrupted() {
    trap - HUP INT TERM
    say "interrupted: cleaning up before exit"
    [ "$PREPARE_NEW" = 1 ] && rollback_new_prepare
    cleanup_lock
    exit 130
}

command=${1:-status}
case "$command" in
    status) status ;;
    prepare|launch|release)
        full_root
        mkdir "$LOCK" 2>/dev/null || die "another command holds $LOCK"
        trap cleanup_lock EXIT
        trap interrupted HUP INT TERM
        case "$command" in
            prepare) prepare "${2:-4096}" ;;
            launch) launch_vm ;;
            release) release_all ;;
        esac
        ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
esac
