void DroidVMAudioDevice::engineMain(void *self, wait_result_t) { static_cast<DroidVMAudioDevice *>(self)->run(); }

// OneiOS (fix-audio-latency): the speaker at the start of its period `done` (the deadline has passed): the zero time
// stamp of a wrap the last period crossed (in the past now, as a DMA wrap's), and the timing counters: how late the
// period was taken (us), how far ahead of it the HAL has written (its write end: iOS's I/O buffer and safety offset as
// used), and whether that came within a period of overwriting what is not yet taken (the ring too small for them).
void DroidVMAudioDevice::oneiosSpeakerPeriod(uint64_t deadline, uint64_t done) {
    EngineStatus *s = status();
    const uint64_t wrap = done / ringFrames * ringFrames;
    if (done && wrap + PeriodFrames > done) {
        s->hostTime = startTime + absolute(wrap);
        __asm__ volatile("dmb ish" ::: "memory");
        s->sampleTime = wrap;
        __asm__ volatile("dmb ish" ::: "memory");
    }
    const uint64_t now = mach_absolute_time();
    uint64_t late = 0;
    if (now > deadline) absolutetime_to_nanoseconds(now - deadline, &late);
    late /= 1000;
    oneios_speaker_periods = oneios_speaker_periods + 1;
    oneios_speaker_late_sum = oneios_speaker_late_sum + late;
    if (late > oneios_speaker_late_max) oneios_speaker_late_max = late;
    const uint64_t written = s->writeEnd;
    oneios_speaker_lead_last = written;
    if (written <= done) return;
    const uint64_t lead = written - done;
    oneios_speaker_leads = oneios_speaker_leads + 1;
    oneios_speaker_lead_sum = oneios_speaker_lead_sum + lead;
    if (lead < oneios_speaker_lead_min) oneios_speaker_lead_min = lead;
    if (lead > oneios_speaker_lead_max) oneios_speaker_lead_max = lead;
    if (lead + PeriodFrames > ringFrames) oneios_speaker_tight = oneios_speaker_tight + 1;
}

// OneiOS (fix-audio-volume): VirtualAudio's volume through the HAL's SetControlValue: the step (clamped to 0..128), its
// gain for the engine, and the description again (on the device and the client: the HAL reads it through both). The
// first 16 changes are logged, then every 64th.
uint32_t DroidVMAudioDevice::oneiosSetVolume(uint64_t value, IORegistryEntry *client) {
    const int32_t asked = int32_t(uint32_t(value));
    const uint32_t v = asked < 0 ? 0 : asked > int32_t(OneiosVolumeSteps) ? OneiosVolumeSteps : uint32_t(asked);
    const bool changed = v != oneios_speaker_volume;
    oneios_speaker_gain = oneios_volume_gain[v];
    oneios_speaker_volume = v;
    if (OSArray *a = oneiosControls(true)) {
        setProperty("controls", a);
        if (client) client->setProperty("controls", a);
        a->release();
    }
    if (changed) {
        const uint32_t n = oneios_speaker_volume_sets + 1;   // no read of a volatile assignment (C++20)
        oneios_speaker_volume_sets = n;
        const uint32_t down = OneiosVolumeSteps - v;   // half dB below 0 dB
        if (n <= 16 || n % 64 == 0)
            IOLog("DroidVMAudio: speaker volume %u of %u (%s%u.%u dB, gain %u of 65536), change %u: iOS's volume, applied here "
                  "(the host plays at full scale)\n", v, (unsigned)OneiosVolumeSteps, v == 0 ? "silent, -" : down ? "-" : "",
                  down / 2, down % 2 * 5, oneios_speaker_gain, n);
    }
    return v;
}
