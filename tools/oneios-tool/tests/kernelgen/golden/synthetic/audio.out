uint64_t absolute(uint64_t frames) { uint64_t t; nanoseconds_to_absolutetime(frames * 1000000000ULL / Rate, &t); return t; }
// OneiOS (fix-audio-volume): the speaker's volume control as the HAL reads it (24A446 CoreAudio's HALS_IOA2Control):
// class 'vlme', base class 'levl', output scope, main element; integers 0..128 over one range from -64 dB in 0.5 dB
// steps (dB values Fixed64, as the sample rates). Step 0 is silence, 128 is 0 dB (the stream as iOS made it).
enum : uint32_t { OneiosVolumeID = 1, OneiosVolumeSteps = 128 };
const uint32_t oneios_volume_gain[OneiosVolumeSteps + 1] = {   // Q16: 65536 x 10^((step / 2 - 64) / 20), 0 at step 0
    0, 44, 46, 49, 52, 55, 58, 62, 66, 69, 74, 78, 83, 87, 93, 98,
    104, 110, 117, 123, 131, 139, 147, 155, 165, 174, 185, 196, 207, 220, 233, 246,
    261, 276, 293, 310, 328, 348, 369, 390, 414, 438, 464, 491, 521, 551, 584, 619,
    655, 694, 735, 779, 825, 874, 926, 981, 1039, 1100, 1165, 1234, 1308, 1385, 1467, 1554,
    1646, 1744, 1847, 1957, 2072, 2195, 2325, 2463, 2609, 2764, 2927, 3101, 3285, 3479, 3685, 3904,
    4135, 4380, 4640, 4915, 5206, 5514, 5841, 6187, 6554, 6942, 7353, 7789, 8250, 8739, 9257, 9806,
    10387, 11002, 11654, 12345, 13076, 13851, 14672, 15541, 16462, 17437, 18471, 19565, 20724, 21952, 23253, 24631,
    26090, 27636, 29274, 31008, 32846, 34792, 36854, 39037, 41350, 43801, 46396, 49145, 52057, 55142, 58409, 61870,
    65536,
};
OSArray *oneiosControls(bool volume) {
    OSArray *list = OSArray::withCapacity(1);
    if (!list || !volume) return list;
    OSDictionary *c = OSDictionary::withCapacity(12), *range = OSDictionary::withCapacity(4);
    OSArray *map = OSArray::withCapacity(1);
    if (c && range && map) {
        setNumber(c, "control ID", OneiosVolumeID);
        setNumber(c, "base class", 0x6c65766c);   // 'levl'
        setNumber(c, "class", 0x766c6d65);        // 'vlme'
        setNumber(c, "scope", 0x6f757470);        // 'outp'
        setNumber(c, "element", 0);
        c->setObject("read only", kOSBooleanFalse);
        setNumber(c, "value", oneios_speaker_volume);
        setNumber(c, "minimum value", 0);
        setNumber(c, "maximum value", OneiosVolumeSteps);
        setNumber(range, "start int value", 0);
        setNumber(range, "start db value", uint64_t(int64_t(-64) * (int64_t(1) << 32)), 64);
        setNumber(range, "integer steps", OneiosVolumeSteps);
        setNumber(range, "db per step", uint64_t(1) << 31, 64);   // 0.5 dB
        map->setObject(range);
        c->setObject("range map", map);
        list->setObject(c);
    }
    OSSafeReleaseNULL(c); OSSafeReleaseNULL(range); OSSafeReleaseNULL(map);
    return list;
}
// One period of the speaker at the volume's gain, in place (480 multiplies a 5 ms period; nothing at 0 dB).
void oneiosVolume(int16_t *s, uint32_t n) {
    const int32_t g = int32_t(oneios_speaker_gain);
    if (g >= 65536) return;
    for (uint32_t i = 0; i < n; i++) s[i] = int16_t((int32_t(s[i]) * g) >> 16);
}
// (before anchor 34)
