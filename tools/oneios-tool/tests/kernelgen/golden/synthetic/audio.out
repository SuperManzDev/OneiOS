// (before anchor 35)
    case 2: {                                              // SetControlValue: the speaker's volume (OneiOS)
        if (!device->speakerEngine() || a->scalarInputCount < 2 || a->scalarInput[0] != OneiosVolumeID) return kIOReturnBadArgument;
        const uint32_t v = device->oneiosSetVolume(a->scalarInput[1], this);
        if (a->scalarOutputCount >= 1) { a->scalarOutput[0] = v; a->scalarOutputCount = 1; }
        return kIOReturnSuccess;
    }
